{
  "name": "tankhwapatra-backend",
  "version": "1.0.0",
  "description": "APIs for tankhwapatra",
  "main": "index.js",
  "lint-staged": {
    "*": "npx prettier --write"
  },
  "scripts": {
    "prepare": "husky install",
    "test": "echo \"Error: no test specified\" && exit 1",
    "check:imports": "node project-check/check-case-sensitive-imports.js",
    "prestart": "npm run check:imports",
    "predev": "npm run check:imports",
    "dev": "nodemon app",
    "start": "nodemon app.js api",
    "start:report-socket": "nodemon app.js report-socket",
    "format": "npx prettier --write .",
    "lint": "eslint . --ext .js,.jsx | prettier --check",
    "migration:generate": "npx sequelize-cli migration:generate --name migration --env development --config config/config.js",
    "migration:run": "npx sequelize-cli db:migrate --env development --config config/config.js",
    "sonar": "npx sonarqube-scanner -X",
    "api:count": "node project-check/count-apis.js"
  },
  "author": "Prince Jain",
  "license": "ISC",
